# AI Data Science Agent - environment template (docs/tech-stack.md §4)
# Copy to .env and fill in. Values below are the accepted v1 defaults.

# LLM (Google Gemini) - required from M3 (planner/narrator)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini (default) or offline: a deterministic rule-based planner for demos without a key
LLM_PROVIDER=gemini

# PRD 6.1 upload limits (Spec 01)
MAX_FILE_SIZE_MB=25
MAX_ROWS=100000

# PRD 6.6 chart cap (Spec 06, used from M4)
MAX_CHARTS=12

# PRD 6.3 bounded LLM retries (Spec 03, used from M3)
PLAN_MAX_RETRIES=3

# PRD 7 privacy: upload retention window in days (Spec 10)
RETENTION_DAYS=7

# Storage (absolute paths recommended; defaults resolve relative to the repo root)
#DB_PATH=D:/ai-agent-for-datascience/storage/app.db
#STORAGE_ROOT=D:/ai-agent-for-datascience/storage

# Observability
LOG_LEVEL=INFO

# Reproducibility (PRD 7)
RANDOM_SEED=42
