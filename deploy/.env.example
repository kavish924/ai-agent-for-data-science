# Spec 11 FR-DP-10: every deployment setting. Copy to deploy/.env (gitignored) for compose.
# On Render the same names are set in render.yaml and the dashboard.
# Lines marked [secret]: never commit a real value.

# ---------- both services ----------
# Turns on the production checks (FR-DP-06/11).
APP_ENV=production
# Shown by /api/v1/health; on Render, RENDER_GIT_COMMIT is used instead.
APP_VERSION=dev
# [secret] The backend only answers callers sending it (FR-DP-14). Render generates it.
INTERNAL_API_TOKEN=

# ---------- frontend ----------
# Shared Basic-auth login (FR-DP-13).
ACCESS_USER=demo
# [secret]
ACCESS_PASSWORD=
# Compose only: host port of the app.
PUBLIC_PORT=3000
# BACKEND_URL: compose sets http://backend:8000; on Render it is the backend's https URL.
# PROXY_TIMEOUT_MS: read at build time, default 300000 (FR-DP-08).

# ---------- backend ----------
# gemini, or offline (rule-based planner, no key).
LLM_PROVIDER=gemini
# aistudio, or vertex (Spec 03 FR-PL-19).
GEMINI_BACKEND=aistudio
# [secret] AI Studio key. Alternatively GEMINI_API_KEY_FILE=/path/to/a/mounted/file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Hosted limits that fit 512 MB (FR-DP-20).
MAX_FILE_SIZE_MB=5
MAX_ROWS=20000
MODEL_MAX_ROWS=10000
RETENTION_DAYS=7
LOG_LEVEL=INFO

# Set by the images or compose; change only if you know why:
#   DB_PATH=/data/app.db, STORAGE_ROOT=/data, LOG_TO_FILE=false,
#   STORAGE_PERSISTENT=true (compose volume) or false (Render free tier, no disk),
#   CORS_ORIGINS= (empty: the browser only talks to the frontend).
